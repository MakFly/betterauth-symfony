{
  "name": "betterauth/symfony-bundle",
  "description": "Symfony-native PASETO authentication bundle with application-owned users and persistence",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": ["symfony", "authentication", "paseto", "oauth", "oidc", "totp", "betterauth"],
  "homepage": "https://github.com/betterauth/betterauth-symfony",
  "support": {
    "issues": "https://github.com/betterauth/betterauth-symfony/issues",
    "source": "https://github.com/betterauth/betterauth-symfony"
  },
  "require": {
    "ext-openssl": "*",
    "php": "^8.4",
    "paragonie/paseto": "^3.1",
    "psr/cache": "^3.0",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^3.0",
    "ramsey/uuid": "^4.7",
    "symfony/config": "^6.4|^7.0|^8.0",
    "symfony/dependency-injection": "^6.4|^7.0|^8.0",
    "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
    "symfony/framework-bundle": "^6.4|^7.0|^8.0",
    "symfony/http-foundation": "^6.4|^7.0|^8.0",
    "symfony/http-kernel": "^6.4|^7.0|^8.0",
    "symfony/security-bundle": "^6.4|^7.0|^8.0",
    "symfony/yaml": "^6.4|^7.0|^8.0"
  },
  "require-dev": {
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^10.5",
    "symfony/browser-kit": "^6.4|^7.0|^8.0",
    "symfony/phpunit-bridge": "^6.4|^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "BetterAuth\\Symfony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BetterAuth\\Symfony\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --memory-limit=256M"
  },
  "conflict": {
    "betterauth/multimodal-php": "*"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^6.4|^7.0|^8.0"
    },
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "suggest": {
    "bacon/bacon-qr-code": "Required only when rendering a TOTP QR code",
    "symfony/mailer": "Required only by an application email sender implementation"
  }
}
